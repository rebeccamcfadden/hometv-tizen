{
  "about": "Every field the check report may hold, and nothing else. The TV's check page (app/src/check/report.ts) and the laptop tool (tools/check/check_report.py) both drop anything that isn't listed here or doesn't match its rule. Rules: bool; int:<min>:<max>; enum:<a>|<b>; re:<pattern name>.",
  "patterns": {
    "version": "^[0-9]{1,4}(\\.[0-9]{1,6}){0,3}$",
    "model": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,39}$",
    "screen": "^[0-9]{3,4}x[0-9]{3,4}$",
    "word": "^[A-Za-z0-9_-]{1,24}$",
    "errname": "^[A-Za-z]{1,40}$",
    "date": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "knownApps": {
    "netflix": { "name": "Netflix", "ids": ["3201907018807", "11101200001"] },
    "youtube": { "name": "YouTube", "ids": ["111299001912"] },
    "prime": { "name": "Prime Video", "ids": ["3201910019365", "3201512006785"] },
    "disney": { "name": "Disney+", "ids": ["3202204027038", "3202009021709", "3201901017640"] },
    "max": { "name": "HBO Max", "ids": ["3202301029760", "3201601007230"] },
    "appletv": { "name": "Apple TV", "ids": ["3201807016597"] },
    "hulu": { "name": "Hulu", "ids": ["3201601007625"] },
    "peacock": { "name": "Peacock", "ids": ["3202006020991"] },
    "paramount": { "name": "Paramount+", "ids": ["3202110025305", "3201710014981"] },
    "spotify": { "name": "Spotify", "ids": ["3201606009684"] },
    "plex": { "name": "Plex", "ids": ["3201512006963"] },
    "tubi": { "name": "Tubi", "ids": ["3201504001965"] },
    "pluto": { "name": "Pluto TV", "ids": ["3201808016802"] }
  },
  "tv": {
    "schema": "enum:hometv-check-1",
    "checkApp": "re:version",
    "finished": "bool",
    "step": "enum:auto|keys|phone|youtube|home|links|done",
    "tv": { "model": "re:model", "tizen": "re:version", "chromium": "int:0:999", "screen": "re:screen" },
    "timing": { "startMs": "int:0:600000" },
    "apps": {
      "listed": "bool",
      "count": "int:0:5000",
      "known": {
        "netflix": "bool", "youtube": "bool", "prime": "bool", "disney": "bool", "max": "bool", "appletv": "bool",
        "hulu": "bool", "peacock": "bool", "paramount": "bool", "spotify": "bool", "plex": "bool", "tubi": "bool",
        "pluto": "bool"
      }
    },
    "services": {
      "watcher": "enum:answers|silent",
      "watcherMs": "int:0:600000",
      "pages": "enum:answers|silent",
      "pagesMs": "int:0:600000"
    },
    "keys": {
      "red": "enum:yes|no", "green": "enum:yes|no", "yellow": "enum:yes|no", "blue": "enum:yes|no",
      "info": "enum:yes|no", "digits": "enum:yes|no|no-buttons"
    },
    "phone": "enum:yes|no|no-phone",
    "youtube": {
      "opened": "enum:yes|no|not-on-tv",
      "error": "re:errname",
      "back": "enum:running|restarted",
      "answer": "enum:back-key|reopened|other"
    },
    "home": {
      "back": "enum:running|restarted",
      "seconds": "int:0:3600",
      "answer": "enum:by-itself|reopened|other"
    },
    "links": {
      "youtubeAppControl": { "sent": "enum:yes|no|not-on-tv", "error": "re:errname", "answer": "enum:title|app|nothing|skipped" },
      "netflixAppControl": { "sent": "enum:yes|no|not-on-tv", "error": "re:errname", "answer": "enum:title|app|nothing|skipped" },
      "netflixRemote": { "sent": "enum:yes|no|not-on-tv", "error": "re:errname", "answer": "enum:title|app|nothing|skipped" },
      "primeAppControl": { "sent": "enum:yes|no|not-on-tv", "error": "re:errname", "answer": "enum:title|app|nothing|skipped" },
      "youtubeDial": { "sent": "enum:yes|no|not-on-tv", "error": "re:errname", "answer": "enum:title|app|nothing|skipped" }
    }
  },
  "laptop": {
    "tool": "re:version",
    "date": "re:date",
    "minutes": "int:0:1440",
    "windows": "re:version",
    "python": "re:version",
    "aerotizen": "re:version",
    "network": "enum:private|none",
    "tvFound": "enum:one|several|none|given",
    "developerMode": "enum:on|off|unknown",
    "hostPcIp": "enum:this-laptop|other|unknown",
    "sdb": "enum:connected|refused",
    "tv": {
      "modelName": "re:model",
      "model": "re:model",
      "year": "int:2010:2040",
      "os": "re:word",
      "platformVersion": "re:version",
      "profile": "re:word",
      "cpuArch": "re:word",
      "sdbdVersion": "re:version"
    },
    "apps": {
      "count": "int:0:5000",
      "known": {
        "netflix": "bool", "youtube": "bool", "prime": "bool", "disney": "bool", "max": "bool", "appletv": "bool",
        "hulu": "bool", "peacock": "bool", "paramount": "bool", "spotify": "bool", "plex": "bool", "tubi": "bool",
        "pluto": "bool"
      }
    },
    "certs": "enum:made|existing|failed",
    "install": "enum:ok|failed",
    "start": "enum:ok|failed",
    "watcherFromLaptop": "enum:answers|silent",
    "pagesFromLaptop": "enum:answers|silent",
    "reportRoute": "enum:inspector|watcher|none",
    "uninstall": "enum:ok|failed"
  }
}
